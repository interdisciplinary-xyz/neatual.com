node_modules
.DS_Store
build
dist

# React Router's generated types and route manifest.
.react-router

# Written by the Vercel preset during `pnpm build`. Build output, not config —
# vercel.json is the checked-in half.
.vercel
.cache
.sanity
.env
.env.*
!.env.example

# Lighthouse CI reports (uploaded as a CI artifact instead)
.lighthouseci

# Camera-roll drop zone. Anything under public/ is served, so 22 MB of HEIC
# masters would be publicly downloadable and shipped on every deploy. The
# masters that the gallery is built from live in art/gallery-originals/.
public/photos

# Working file from `pnpm content:pull`. Sanity is the source of truth;
# a stale copy checked in invites someone pushing week-old text.
content.json
