# Sanity. The project already exists — copy this file to .env as-is.
# Manage at https://www.sanity.io/manage/project/kyyf7nu9
SANITY_STUDIO_PROJECT_ID=kyyf7nu9
SANITY_STUDIO_DATASET=production

# Pin the API date so a future Sanity API change can't alter responses silently.
SANITY_STUDIO_API_VERSION=2026-08-10

# Subdomain for the separately hosted Studio: <host>.sanity.studio
# Only used by `pnpm sanity:deploy`.
SANITY_STUDIO_HOST=neatual

# Optional. `pnpm seed:sanity:import` uses your `sanity login` session instead,
# so a token is only needed for `pnpm seed:sanity` (e.g. in CI).
# Create at https://www.sanity.io/manage/project/kyyf7nu9/api#tokens
SANITY_WRITE_TOKEN=
